{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ui-web-storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "packages/ui-web", "storybook"],
      "port": 6007
    },
    {
      "name": "console-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "apps/console", "dev"],
      "port": 3000
    },
    {
      "name": "lci-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "apps/lci", "dev"],
      "port": 3001
    },
    {
      "name": "authz-ui-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "apps/authz-ui", "dev"],
      "port": 5173
    },
    {
      "name": "ui-web-storybook-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "6100",
        "--directory",
        "packages/ui-web/storybook-static"
      ],
      "port": 6100
    }
  ]
}
