packages/api-rest/openapi-ts-error-*.log
# Turborepo — local task logs + cache. MUST be ignored, otherwise turbo counts
# its own run logs as task inputs and the cache never hits.
.turbo/
npm-debug.*
*.key
*.orig.*
storybook-static/

# macOS
.DS_Store

packages/**/client
packages/authz-rpc/generated/

.qwen/
gha-creds-*.json
.opencode/
opencode.json

# Helm dependency tarballs vendored by `helm dependency update` into charts/<name>/charts/.
# Regenerated on demand from Chart.lock (which IS committed) by every consumer, including
# publish-charts-oci.yml's own `helm dependency build` — committing the .tgz would put a
# multi-hundred-KB binary under review on every dependency bump for no gain.
charts/*/charts/
