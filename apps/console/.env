# Local development defaults for apps/console. Committed on purpose, matching
# apps/self-service/.env — every value here points at the repo's own compose stack and none of it
# is a credential. See .env.example for what each variable does.

# NOT A SECRET: a fixed, published, local-development-only string, long enough to satisfy the
# 32-character floor. Any real deployment MUST supply its own SESSION_SECRET (openssl rand -base64
# 48); the app has no default and refuses to start a session without one.
SESSION_SECRET=local-development-only-console-session-key-do-not-use-in-any-deployment

# Shared local Keycloak (compose.yml `keycloak-26`, realm imported from
# .docker/keycloak-config/realm.theme.vymalo-wh-01.json).
KEYCLOAK_ISSUER=http://localhost:13444/realms/lightbridge-dev
KEYCLOAK_CLIENT_ID=self-service

# The imported dev realm's `self-service` client carries no audience mapper, so requiring an
# audience locally would block every login. Production sets both.
EXPECTED_AUDIENCES=converse-frontend
AUDIENCE_REQUIRED=true

# Local lightbridge-authz stack (compose.yaml + compose.override.yaml in that repo).
BACKEND_URL=http://localhost:13000
API_BASE_PATH=/api
BUDGET_URL=http://localhost:13005

# No local usage backend: /api/usage/* answers 503 and the Overview says so inline.
# USAGE_URL=

PUBLIC_BASE_URL=http://localhost:3000
