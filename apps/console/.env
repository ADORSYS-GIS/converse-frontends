# Local development defaults for apps/console. Committed on purpose, matching
# apps/self-service/.env — every value here backs a `{env:VAR}` placeholder in config.yaml, and
# none of it is a real secret. See .env.example for what each variable does, and config.yaml for
# everything that's now a plain literal there instead of an env var.

# NOT A SECRET: a fixed, published, local-development-only string, long enough to satisfy the
# 32-character floor. Any real deployment MUST supply its own SESSION_SECRET (openssl rand -base64
# 48); config.yaml has no literal fallback for it — it always resolves from this placeholder.
SESSION_SECRET=local-development-only-console-session-key-do-not-use-in-any-deployment

# The imported dev realm's `self-service` client is public + PKCE, so no client secret locally.
# KEYCLOAK_CLIENT_SECRET=
