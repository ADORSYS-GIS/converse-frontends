# apps/console — server-side runtime configuration.
#
# Every variable here is read by Next.js route handlers and server components ONLY. None is
# prefixed `NEXT_PUBLIC_`, so none reaches the browser (ADR 0009 Decision 3: the console is the only
# exposed origin; the browser talks to same-origin /api/* and nothing else). The nginx/envsubst
# `EXPO_PUBLIC_*`/config.json machinery the Expo app needs has no equivalent here.

# ── Session encryption ────────────────────────────────────────────────────────────────────────
# Cookie-session JWE key material (A256GCM via an HKDF of this value). At least 32 characters.
# Deploy-time secret: rotating it invalidates every live session. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# ── Keycloak / OIDC ───────────────────────────────────────────────────────────────────────────
# Issuer URL — discovery resolves every endpoint from it, nothing is hardcoded.
# Local compose (compose.yml `keycloak-26` + .docker/keycloak-config/):
KEYCLOAK_ISSUER=http://localhost:13444/realms/lightbridge-dev
KEYCLOAK_CLIENT_ID=self-service

# Only for a confidential client. The dev realm's `self-service` client is public + PKCE, so leave
# this unset there; setting it switches the client to `client_secret_post` authentication.
# KEYCLOAK_CLIENT_SECRET=

# `offline_access` is what makes the long-lived silent refresh possible, exactly as today.
# KEYCLOAK_SCOPES=openid profile email offline_access

# ── JWT audience validation ───────────────────────────────────────────────────────────────────
# Comma-separated. The access token's `aud` must contain at least one of these, checked on login
# AND on every refresh; a mismatch blocks the session. Mirrors
# EXPO_PUBLIC_KEYCLOAK_EXPECTED_AUDIENCE. Leave empty to skip the check entirely (not recommended).
EXPECTED_AUDIENCES=lightbridge-api-key,converse-frontend,lightbridge-token-issuer

# `false` allows a token with no `aud` claim at all. A WRONG audience is always rejected regardless.
AUDIENCE_REQUIRED=true

# Claim carrying the caller's RBAC roles. Matches `getJwtRoles`' default in
# packages/hooks/src/auth/jwt-utils.ts. Keycloak's realm_access/resource_access roles are merged in
# as well, so a realm granting `lightbridge-admin` natively also works.
# ROLES_CLAIM=lightbridge_api_roles

# ── Backends (never exposed to the browser) ───────────────────────────────────────────────────
# authz-api. Local lightbridge-authz compose stack, plaintext HTTP dev mode.
BACKEND_URL=http://localhost:13000

# RPC base path on authz-api — `/api/rpc/{op_id}` is served under this prefix.
# API_BASE_PATH=/api

# authz-budget: the microservice the 14 budget:*-gated procedures moved onto (hard cutover,
# lightbridge-authz PR #351). Defaults to BACKEND_URL; budget calls 404 until this points at a
# real authz-budget instance.
BUDGET_URL=http://localhost:13005

# The usage backend (POST /usage/v1/usage/query). Leave unset until one is reachable —
# /api/usage/* then answers 503 and the Overview renders its honest "unwired" status line rather
# than an empty chart that reads as zero usage.
# USAGE_URL=

# ── Public origin ─────────────────────────────────────────────────────────────────────────────
# The absolute origin browsers reach this app on. Used to build the OIDC redirect URI, the RP-
# initiated logout redirect and the /.well-known/oauth-protected-resource `resource` identifier.
# Falls back to the incoming request's own origin, which is correct for local development but NOT
# behind a proxy that rewrites Host — set it explicitly in any real deployment.
# PUBLIC_BASE_URL=http://localhost:3000
