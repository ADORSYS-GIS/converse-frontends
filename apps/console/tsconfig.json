{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Mandated by `next build` — Next uses the React automatic runtime.
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      // `tsc`-only shim for `@lightbridge/ui-web`'s own `"./src/*"` wildcard: several `apps/console`
      // modules import a `ui-web` page/component directly from its own subpath instead of the
      // package barrel (`src/index.ts`) to keep the barrel's `d3`-backed chart re-exports out of
      // routes that never render a chart — see `src/client/console-chrome.tsx`'s doc comment.
      "@lightbridge/ui-web/src/*": ["../../packages/ui-web/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    // `spec-page.tsx`'s own `?raw` YAML import (see that file's doc comment) needs this ambient
    // declaration to typecheck. `ui-web`'s own tsconfig already includes it via `"src"`; this app's
    // does not reach into `packages/ui-web/src` on its own, and `spec-page-story-parity.test.ts`
    // (converse-frontends#487/#492 follow-up) is the first file here to import that module.
    "../../packages/ui-web/src/vite-raw-imports.d.ts"
  ],
  // `src/sw.ts` is a service worker: it needs `lib: webworker`, whose `self` typing is
  // irreconcilable with the `DOM` lib this app needs everywhere else. `@serwist/turbopack`'s
  // `createSerwistRoute` (`src/app/serwist/[path]/route.ts`) bundles it with `esbuild-wasm` in its
  // own worker-targeted pass; `tsc` deliberately does not look at it.
  "exclude": ["node_modules", ".next", "src/sw.ts"]
}
