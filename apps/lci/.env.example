# apps/lci OIDC client config and control-plane URL. Copy to .env.local for local dev.
#
# apps/lci authenticates against LCI's OWN Keycloak realm and control plane — this app is a new
# frontend for LCI's existing backend (epic #328), not a new backend. In dev these point at the
# lightbridge-code-intelligence repo's own local stack (`just up`, `docs/local-setup.md`).

# OIDC provider (Keycloak realm). Used for discovery, login redirect, and token validation.
OIDC_ISSUER=http://localhost:8081/realms/lightbridge

# Client id (pre-seeded in lightbridge-code-intelligence's deploy/keycloak/realm-lightbridge.json,
# shared with LCI's own apps/web — a public client, PKCE only, no secret needed locally).
OIDC_CLIENT_ID=lightbridge-web

# Where Keycloak redirects back after login, and after logout. apps/lci runs on a different port
# than lightbridge-code-intelligence's own apps/web (3001 here vs. 3000 there) so both can run
# side by side during the migration — both origins are registered on the shared dev client.
OIDC_REDIRECT_URI=http://localhost:3001/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3001

# Expected access-token audience. Optional on the web tier; the control plane enforces it.
OIDC_AUDIENCE=lightbridge-api

# Control-plane base URL for server-side API calls. Must include the /api/v2 prefix.
CONTROL_PLANE_URL=http://localhost:8080/api/v2
