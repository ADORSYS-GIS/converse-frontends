# Local lightbridge-authz stack (compose.yaml + compose.override.yaml in the
# lightbridge-authz repo) — plaintext HTTP dev mode, CORS enabled.
EXPO_PUBLIC_BACKEND_URL=http://localhost:13000

# authz-budget: the microservice the 14 budget:*-gated RPC procedures moved onto (hard cutover,
# lightbridge-authz PR #351 — authz-api no longer serves them). Local compose exposes it on
# 13005. Leave unset to fall back to EXPO_PUBLIC_BACKEND_URL (budget calls will 404 until this
# points at a real authz-budget instance).
EXPO_PUBLIC_BUDGET_URL=http://localhost:13005

# Shared local Keycloak (same instance the backend validates JWTs against).
EXPO_PUBLIC_KEYCLOAK_ISSUER=http://localhost:9100/realms/dev
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=test-client
EXPO_PUBLIC_KEYCLOAK_SCHEME=self-service

# JWT Audience Validation
# Expected audience(s) for JWT token validation (comma-separated for multiple audiences)
# The token's 'aud' claim must contain at least one of these values
EXPO_PUBLIC_KEYCLOAK_EXPECTED_AUDIENCE=lightbridge-api-key,converse-frontend,lightbridge-token-issuer

# Set to 'false' to allow tokens without audience claim (not recommended for production)
EXPO_PUBLIC_KEYCLOAK_AUDIENCE_REQUIRED=true

EXPO_PUBLIC_GATEWAY_URL=https://api.ai.camer.digital

# Grafana usage-dashboard embed (Usage tab). Optional — leave unset to hide the
# tab (ships dark). For the embed to actually render, Grafana must be served
# same-site as this app and have `allow_embedding = true` + a CSP
# `frame-ancestors` allowing this origin; otherwise the iframe stays blocked by
# X-Frame-Options. The dashboard filters to the signed-in user via the shared
# Keycloak SSO session, so the user must have a live Grafana session.
# EXPO_PUBLIC_GRAFANA_URL=https://grafana.ai.camer.digital
# EXPO_PUBLIC_GRAFANA_USAGE_DASHBOARD_PATH=/d/my-usage/ai-gateway-e28094-my-usage