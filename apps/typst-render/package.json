{
  "name": "typst-render",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --experimental-strip-types src/index.ts",
    "build:web": "tsc -p tsconfig.build.json",
