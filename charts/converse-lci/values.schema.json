{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "converse-lci values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "labels": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "app": { "type": "string" },
            "team": { "type": "string" }
          }
        }
      }
    },
    "lci": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "controllers": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "main": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "containers": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "frontend": {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "image": {
                          "type": "object",
                          "additionalProperties": true,
                          "properties": {
                            "repository": { "type": "string", "minLength": 1 },
                            "tag": { "type": "string", "minLength": 1 }
                          },
                          "required": ["repository", "tag"]
                        },
                        "env": {
                          "description": "apps/lci's runtime configuration — plain environment variables, not a mounted config document. See README.md for the full field reference; the keys below are the ones the app cannot boot or authenticate without (apps/lci/src/lib/auth/oidc-config.ts, verify-jwt.ts, lib/server/admin.ts).",
                          "type": "object",
                          "properties": {
                            "OIDC_ISSUER": {
                              "description": "The OIDC provider this deployment authenticates against (e.g. authz-idp). Thrown on missing (verify-jwt.ts, oidc-config.ts).",
                              "type": "string",
                              "minLength": 1
                            },
                            "OIDC_CLIENT_ID": {
                              "description": "This app's registered OIDC client id. Thrown on missing (oidc-config.ts).",
                              "type": "string",
                              "minLength": 1
                            },
                            "CONTROL_PLANE_URL": {
                              "description": "The LCI control plane's base URL. Not enforced by app code (silently falls back to http://localhost:8080/api/v2 if unset), so required here to fail fast instead of a deployment silently pointing at nothing.",
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": ["OIDC_ISSUER", "OIDC_CLIENT_ID", "CONTROL_PLANE_URL"],
                          "anyOf": [
                            { "required": ["OIDC_REDIRECT_URI"] },
                            { "required": ["OIDC_POST_LOGOUT_REDIRECT_URI"] }
                          ]
                        }
                      },
                      "required": ["image", "env"]
                    }
                  },
                  "required": ["frontend"]
                }
              },
              "required": ["containers"]
            }
          },
          "required": ["main"]
        },
        "configMaps": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "branding-logo": {
              "description": "Runtime white-label logo. Optional — disabled (lci.configMaps.branding-logo.enabled: false) by default, in which case the app renders its own built-in mark. Holds the operator's logo file as base64 binaryData, mounted at /tmp/branding/logo.png (lci.persistence.branding-logo). Despite the literal key name, any extension apps/lci's branding.ts accepts (.png/.svg/.jpg/.jpeg/.webp) may be supplied — the key is the ConfigMap's, not a format constraint; LCI_BRANDING_LOGO_PATH's own extension decides the served Content-Type.",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" },
                "binaryData": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "logo.png": { "type": "string" }
                  }
                }
              }
            },
            "branding-logo-light": {
              "description": "Per-theme logo addendum. Optional — disabled by default, matching branding-logo above. Only meaningful when branding-logo is ALSO enabled — a light-only brand renders no mark under black, this app's default theme. Holds the operator's light-theme logo file as base64 binaryData, mounted at /tmp/branding/logo-light.png (lci.persistence.branding-logo-light).",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" },
                "binaryData": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "logo-light.png": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "required": ["controllers"]
    }
  },
  "required": ["lci"]
}
