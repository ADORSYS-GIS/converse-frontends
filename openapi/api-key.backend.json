  "components": {
    "schemas": {
      "Account": {
        "type": "object",
        "required": ["id", "billing_identity", "created_at", "updated_at"],
        "properties": {
          "billing_identity": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "id": { "type": "string" },
          "owners_admins": { "type": "array", "items": { "type": "string" } },
          "status": { "$ref": "#/components/schemas/ResourceStatus" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "AddAccountMember": {
        "type": "object",
        "description": "Body for adding a member to an account. `subject` is the member's identity (the Keycloak `sub`),\nthe same value carried on their bearer token. Must be non-empty (enforced by the store).",
        "required": ["subject"],
        "properties": { "subject": { "type": "string", "minLength": 1 } }
      },
      "ApiKey": {
        "type": "object",
        "required": [
          "id",
          "project_id",
          "name",
          "key_prefix",
          "created_at",
          "status",
          "billing_plan"
        ],
        "properties": {
          "billing_plan": {
            "type": "string",
            "description": "Billing plan this key is minted on. Chosen at creation from the operator-configured\n(env-driven) plan set; preserved across rotation."
          },
          "created_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": ["string", "null"], "format": "date-time" },
          "id": { "type": "string" },
          "key_prefix": { "type": "string" },
          "last_ip": { "type": ["string", "null"] },
          "last_used_at": { "type": ["string", "null"], "format": "date-time" },
          "name": { "type": "string" },
          "project_id": { "type": "string" },
          "revoked_at": { "type": ["string", "null"], "format": "date-time" },
          "status": { "$ref": "#/components/schemas/ApiKeyStatus" }
        }
      },
      "ApiKeySecret": {
        "type": "object",
        "required": ["api_key", "secret"],
        "properties": {
          "api_key": { "$ref": "#/components/schemas/ApiKey" },
          "oauth2_url": { "type": ["string", "null"] },
          "secret": { "type": "string" }
        }
      },
      "ApiKeyStatus": { "type": "string", "enum": ["active", "revoked"] },
      "CreateAccount": {
        "type": "object",
        "required": ["billing_identity"],
        "properties": { "billing_identity": { "type": "string" } }
      },
      "CreateApiKey": {
        "type": "object",
        "required": ["name", "billing_plan"],
        "properties": {
          "billing_plan": {
            "type": "string",
            "description": "Billing plan for the key. Required, and must be one of the operator-configured\n(env-driven) billing plans, otherwise creation is rejected with `400 Bad Request`."
          },
          "expires_at": { "type": ["string", "null"], "format": "date-time" },
          "name": { "type": "string" }
        }
      },
      "CreateProject": {
        "type": "object",
        "required": ["name", "billing_plan"],
        "properties": {
          "allowed_models": { "type": ["array", "null"], "items": { "type": "string" } },
          "billing_plan": { "type": "string" },
          "default_limits": {
            "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/DefaultLimits" }]
          },
          "name": { "type": "string" }
        }
      },
      "DefaultLimits": {
        "type": "object",
        "properties": {
          "concurrent_requests": { "type": ["integer", "null"], "format": "int32" },
          "requests_per_day": { "type": ["integer", "null"], "format": "int32" },
          "requests_per_second": { "type": ["integer", "null"], "format": "int32" }
        }
      },
      "Project": {
        "type": "object",
        "required": ["id", "account_id", "name", "billing_plan", "created_at", "updated_at"],
        "properties": {
          "account_id": { "type": "string" },
          "allowed_models": { "type": ["array", "null"], "items": { "type": "string" } },
          "billing_plan": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "default_limits": {
            "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/DefaultLimits" }]
          },
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "$ref": "#/components/schemas/ResourceStatus" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "ResourceStatus": {
        "type": "string",
        "description": "Lifecycle state of an account or project. `Suspended` is a soft-disable: the row and its\ndescendants are kept, but every API key beneath a suspended account/project fails validation.",
        "enum": ["active", "suspended"]
      },
      "RotateApiKey": {
        "type": "object",
        "description": "Rotation mints a fresh secret for an existing key. It does not carry a `billing_plan`: a key's\nplan is fixed at creation and preserved across rotation (there is no supported path to change a\nkey's plan — create a new key on the desired plan instead).",
        "properties": {
          "expires_at": { "type": ["string", "null"], "format": "date-time" },
          "grace_period_seconds": { "type": ["integer", "null"], "format": "int64" },
          "name": { "type": ["string", "null"] }
        }
      },
      "UpdateAccount": {
        "type": "object",
        "properties": {
          "billing_identity": { "type": ["string", "null"] },
          "owners_admins": { "type": ["array", "null"], "items": { "type": "string" } }
        }
      },
      "UpdateApiKey": {
        "type": "object",
        "properties": {
          "expires_at": { "type": ["string", "null"], "format": "date-time" },
          "name": { "type": ["string", "null"] }
        }
      },
      "UpdateProject": {
        "type": "object",
        "properties": {
          "allowed_models": { "type": ["array", "null"], "items": { "type": "string" } },
          "billing_plan": { "type": ["string", "null"] },
          "default_limits": {
            "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/DefaultLimits" }]
          },
          "name": { "type": ["string", "null"] }
        }
      }
    },
    "securitySchemes": {
      "bearer_auth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    }
  },
  "security": [{ "bearer_auth": [] }],
  "tags": [
    { "name": "accounts", "description": "Account management" },
    { "name": "projects", "description": "Project management" },
    { "name": "api_keys", "description": "API key management" }
  ]
}
