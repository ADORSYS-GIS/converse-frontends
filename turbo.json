{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "codegen": {
      "outputs": ["generated/**", "src/client/**"]
    },
    "build:web": {
      "dependsOn": ["^build:web", "codegen"],
      "outputs": ["dist/**"]
    },
    "build-storybook": {
      "dependsOn": ["codegen"],
      "outputs": ["storybook-static/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/lci/src/**"]
    }
  }
}
